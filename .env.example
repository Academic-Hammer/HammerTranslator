# Copy this file to .env and fill only the providers you use.
# .env is local-only and ignored; never commit or paste real values into chat.
# The variable names must match the api_key_env values in translation_config.yaml.
TRANSLATION_API_KEY=
OPENAI_API_KEY=

# Optional directory with a custom font manifest and its pinned font files.
# Leave empty to use the fonts installed by `hammer-fonts install`.
HAMMERTRANSLATOR_FONTS_DIR=

# Optional path overrides. Uncomment and fill only when the default locations
# (documented in docs/RUNTIME_CONFIGURATION.md) do not suit your deployment.
# HAMMERTRANSLATOR_HOME=
# HAMMERTRANSLATOR_JOBS_ROOT=
# HAMMERTRANSLATOR_CONFIG=
# HAMMERTRANSLATOR_ENV_FILE=
# HAMMERTRANSLATOR_FORMULA_RUNTIME_DIR=
# HAMMERTRANSLATOR_MODEL_CACHE=
# HAMMERTRANSLATOR_TEMP_DIR=
# HAMMERTRANSLATOR_MINERU_SOURCE=
