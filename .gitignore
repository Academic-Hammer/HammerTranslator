# Local secrets
.env
.env.*
!.env.example

# Editor and operating-system metadata
.vscode/
.idea/
.DS_Store

# Python build, test, and runtime artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# JavaScript dependencies are restored from package-lock.json
node_modules/

# Optional operator-owned fonts are never committed. The default font manifest
# and OFL notice are versioned; binaries are installed with `hammer-fonts`.
assets/fonts/*.ttf
assets/fonts/*.ttc
assets/fonts/*.otf

# Logs, caches, and temporary files
*.log
tmp/
.cache/

# Local pipeline jobs and uploaded PDFs
var/
input_pdf/

# Local paper corpus and translated snapshots used for manual evaluation.
paper/

# Local datasets, historical outputs, and archives
local_data/
/270-new/
/270-new.zip

# Historical projects retained locally during cleanup
legacy/projects/

# External source trees used by the current local environment. Keep the
# directory documentation, but do not version third-party repositories here.
external/*
!external/README.md

# Ad-hoc rendering experiments and scratch scripts
.codex-render/
